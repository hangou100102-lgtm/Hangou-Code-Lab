# 依赖
node_modules/

# 构建产物（由 GitHub Actions 在 CI 中构建后发布，不入库）
dist/

# 构建缓存
*.tsbuildinfo

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 本地环境变量（含接口地址等本机配置，模板见 .env.example）
.env.local
.env.*.local

# 后端数据库配置（含密码，模板见 api/config.example.php）
api/config.php

# 安装锁：由 api/install.php 在服务器上生成，属于运行状态，不入库
api/install.lock
